# non-code artifacts: always ignored, whole folder (code auto-creates these
# via mkpath/mkdir on write, so there's no need to pre-seed them in git)
data/
logs/

# Julia
julia/*.jl.cov
julia/deps/deps.jl
# not tracked: resolved across different Julia versions/platforms (macOS dev
# machine vs Linux cluster), each machine should Pkg.instantiate() its own
julia/Manifest.toml

# Python
python/.venv/
python/**/__pycache__/
python/**/*.egg-info/
*.pyc

# OS / editors
.DS_Store
.vscode/
.claude/
